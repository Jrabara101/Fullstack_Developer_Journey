  }</script></head><body class="bg-background font-body-md text-on-surface antialiased"><aside class="fixed left-0 top-0 bottom-0 w-64 bg-surface-container-lowest z-40 flex flex-col justify-between shadow-[0_1px_8px_rgba(0,0,0,0.04)]"><div class="flex flex-col h-full"><div class="h-14 px-space-lg flex items-center gap-space-sm bg-surface-container-lowest"><img alt="Apex Enterprise Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1V-2TFg9sjKKA19Vjew1wlcga1Ea6xvXo680Xc-GItdwQ9GFLq9W6iz0EhXwV6VIpBWfdpWo7rFAuW2uexpBPgeWDl8oK2Vanc2EzCB2tM4tc9mXwYUHojVKx2mmqvaThGSgz6_2cIXc7XK9NrCmLSQCop1IU32jSaRuAkVobexWdnnNHgcmXphWtEzE08s5Iqb26Urbovj9jEvv2fJEeBXiOtZ_veVSCTAAMyuz7iTzJopsEJRfo5AmYY"/><span class="font-headline-sm text-headline-sm text-on-surface tracking-tight">Apex</span><span class="ml-auto bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm px-1.5 py-0.5 rounded">v4.2</span></div><div class="flex-1 overflow-y-auto px-space-md py-space-sm space-y-space-lg"><nav class="space-y-space-xs" data-active-classes="bg-primary-container text-on-primary font-body-sm"><div class="px-space-sm py-1 text-label-sm font-label-sm uppercase tracking-wider text-outline">Core</div><a aria-current="page" class="flex items-center gap-space-sm px-space-sm py-1.5 rounded-lg transition-colors bg-primary-container text-on-primary font-body-sm" data-path="overview" href="#"><span class="material-symbols-outlined text-[18px]">dashboard</span>Overview</a><a class="flex items-center gap-space-sm px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-body-sm text-body-sm transition-colors" data-path="analytics" href="#"><span class="material-symbols-outlined text-[18px]">analytics</span>Analytics</a><a class="flex items-center gap-space-sm px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-body-sm text-body-sm transition-colors" data-path="live-ops" href="#"><span class="material-symbols-outlined text-[18px]">monitoring</span>Live Ops</a></nav><nav class="space-y-space-xs" data-active-classes="bg-primary-container text-on-primary font-body-sm"><div class="px-space-sm py-1 text-label-sm font-label-sm uppercase tracking-wider text-outline">Management</div><a class="flex items-center gap-space-sm px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-body-sm text-body-sm transition-colors" data-path="users-permissions" href="#"><span class="material-symbols-outlined text-[18px]">group</span>Users &amp; Permissions</a><a class="flex items-center gap-space-sm px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-body-sm text-body-sm transition-colors" data-path="billing-revenue" href="#"><span class="material-symbols-outlined text-[18px]">receipt_long</span>Billing &amp; Revenue</a><a class="flex items-center gap-space-sm px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-body-sm text-body-sm transition-colors" data-path="system-logs" href="#"><span class="material-symbols-outlined text-[18px]">terminal</span>System Logs</a></nav><nav class="space-y-space-xs" data-active-classes="bg-primary-container text-on-primary font-body-sm"><div class="px-space-sm py-1 text-label-sm font-label-sm uppercase tracking-wider text-outline">Configuration</div><a class="flex items-center gap-space-sm px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-body-sm text-body-sm transition-colors" data-path="api-keys" href="#"><span class="material-symbols-outlined text-[18px]">key</span>API Keys</a><a class="flex items-center gap-space-sm px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-body-sm text-body-sm transition-colors" data-path="integrations" href="#"><span class="material-symbols-outlined text-[18px]">hub</span>Integrations</a><a class="flex items-center gap-space-sm px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-body-sm text-body-sm transition-colors" data-path="audit-trail" href="#"><span class="material-symbols-outlined text-[18px]">history</span>Audit Trail</a><a class="flex items-center gap-space-sm px-space-sm py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-body-sm text-body-sm transition-colors" data-path="settings" href="#"><span class="material-symbols-outlined text-[18px]">settings</span>Settings</a></nav></div><div class="p-space-md bg-surface-container-lowest"><div class="flex items-center justify-between px-space-sm py-1.5 bg-surface-container-low rounded-lg mb-space-sm"><div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-tertiary"></span><span class="font-label-sm text-label-sm text-on-surface-variant">Operational</span></div><span class="font-label-sm text-label-sm text-outline">99.98%</span></div><div class="flex items-center justify-between p-space-sm rounded-lg hover:bg-surface-container-high transition-colors cursor-pointer"><div class="flex items-center gap-space-sm min-w-0"><div class="w-6 h-6 rounded bg-primary text-on-primary flex items-center justify-center font-label-sm text-label-sm font-bold">US</div><div class="min-w-0"><div class="font-body-sm text-body-sm text-on-surface font-medium truncate">US-East Prod</div><div class="font-caption text-caption text-outline truncate">Enterprise Tier</div></div></div><span class="material-symbols-outlined text-outline text-[18px]">unfold_more</span></div></div></div></aside><div class="pl-64"><header class="fixed top-0 left-64 right-0 h-14 bg-surface-container-lowest z-30 shadow-[0_1px_8px_rgba(0,0,0,0.04)] px-space-lg flex items-center justify-between gap-space-md"><div class="flex items-center gap-2 font-body-sm text-body-sm text-outline min-w-max"><span class="hover:text-on-surface transition-colors cursor-pointer">Workspaces</span><span>/</span><span class="hover:text-on-surface transition-colors cursor-pointer">US-East-1</span><span>/</span><span class="text-on-surface font-medium">Overview</span></div><div class="flex-1 max-w-lg mx-space-lg"><div class="relative flex items-center w-full"><span class="material-symbols-outlined absolute left-space-sm text-outline text-[18px]">search</span><input class="w-full h-8 pl-8 pr-16 bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest" placeholder="Search operations, logs, or metrics..." type="text"/><kbd class="absolute right-2 font-label-sm text-label-sm bg-surface-container text-on-surface-variant px-1.5 py-0.5 rounded shadow-sm">⌘K</kbd></div></div><div class="flex items-center gap-space-md"><button class="h-8 px-space-sm flex items-center gap-space-xs bg-surface-container-low hover:bg-surface-container-high text-on-surface rounded-lg font-body-sm text-body-sm transition-colors"><span class="material-symbols-outlined text-[16px] text-outline">calendar_today</span><span>Oct 1 - Oct 31, 2024</span><span class="material-symbols-outlined text-[16px] text-outline">arrow_drop_down</span></button><button class="relative p-1.5 text-on-surface-variant hover:text-on-surface rounded-lg hover:bg-surface-container-high transition-colors"><span class="material-symbols-outlined text-[20px]">notifications</span><span class="absolute top-1 right-1 w-2 h-2 rounded-full bg-error ring-2 ring-surface-container-lowest"></span></button><button class="p-1.5 text-on-surface-variant hover:text-on-surface rounded-lg hover:bg-surface-container-high transition-colors"><span class="material-symbols-outlined text-[20px]">help_outline</span></button><div class="h-4 w-[1px] bg-surface-container-high"></div><div class="flex items-center gap-2 cursor-pointer hover:opacity-80 transition-opacity"><img alt="Profile" class="w-8 h-8 rounded-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDG1trkW1UCfZPXYbFI-aT0hSTk_WIFBBHYG43_l83KJhTM9RNo6KsgFYTfFX6tEnh4RiLMWR_RzUm3-MTS2kagQG80zZuspipuOerC-65PNUWDCiJMJ0W7Hrht5rPHcxq5q9XNXkEAKz6cv9YhrRWqJpIKKkdOvvoXaBa9Q7bjGywMroib8XvdkAig5kL7daR966e9LUbygBD4kU28mmMehFBK0P2wXyEFN_ynbaqEMJdaJH5J8OuS"/><span class="material-symbols-outlined text-outline text-[18px]">keyboard_arrow_down</span></div></div></header><main class="w-full pt-14 px-gutter-desktop min-h-screen bg-background"><div class="flex flex-col w-full pb-10 space-y-space-lg">
<!-- 1. Header & Actions Bar -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md pt-space-sm">
<div class="space-y-0.5">
<div class="flex items-center gap-2">
<h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Enterprise Overview</h1>
<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-surface-container-low text-tertiary font-label-sm text-label-sm font-medium">
<span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-pulse"></span>
          Live Feed
        </span>
</div>
<p class="font-body-sm text-body-sm text-outline flex items-center gap-1.5">
        Overview &amp; Real-time Operations
        <span class="inline-block w-1 h-1 rounded-full bg-outline-variant"></span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Last synced 24s ago</span>
</p>
</div>
<!-- Actions -->
<div class="flex items-center gap-space-sm flex-wrap">
<button class="h-8 px-3 inline-flex items-center gap-1.5 rounded-lg bg-surface-container-lowest text-on-surface font-body-sm text-body-sm shadow-sm hover:bg-surface-container-high transition-colors">
<span class="material-symbols-outlined text-[16px] text-outline">tune</span>
<span>Filter Presets</span>
</button>
<button class="h-8 px-3 inline-flex items-center gap-1.5 rounded-lg bg-surface-container-lowest text-on-surface font-body-sm text-body-sm shadow-sm hover:bg-surface-container-high transition-colors">
<span class="material-symbols-outlined text-[16px] text-outline">file_download</span>
<span>Export CSV</span>
</button>
<button class="h-8 px-3.5 inline-flex items-center gap-1.5 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-body-sm text-body-sm font-medium shadow-sm transition-colors">
<span class="material-symbols-outlined text-[16px]">add</span>
<span>Create Batch Action</span>
</button>
</div>
</div>
<!-- 2. KPI Metric Cards (Grid of 4) -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
<!-- Card 1: Gross Revenue -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between space-y-3">
<div class="flex items-start justify-between">
<div class="space-y-1">
<span class="font-label-sm text-label-sm tracking-wider uppercase text-outline">Total Gross Revenue</span>
<div class="font-headline-md text-headline-md text-on-surface font-semibold font-label-md tracking-tight">
            $1,284,920.40
          </div>
</div>
<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-surface-container-low text-tertiary font-label-sm text-label-sm font-medium">
<span class="material-symbols-outlined text-[14px]">trending_up</span>
          +12.4%
        </span>
</div>
<!-- Mini Sparkline SVG -->
<div class="h-8 w-full flex items-end">
<svg class="w-full h-8 overflow-visible" preserveaspectratio="none" viewbox="0 0 100 24">
<defs>
<lineargradient id="gradRev" x1="0" x2="0" y1="0" y2="1">
<stop offset="0%" stop-color="#006242" stop-opacity="0.25"></stop>
<stop offset="100%" stop-color="#006242" stop-opacity="0.0"></stop>
</lineargradient>
</defs>
<path d="M0,20 Q12,18 25,14 T50,15 T75,8 T100,2 L100,24 L0,24 Z" fill="url(#gradRev)"></path>
<path d="M0,20 Q12,18 25,14 T50,15 T75,8 T100,2" fill="none" stroke="#006242" stroke-linecap="round" stroke-width="1.75"></path>
</svg>
</div>
<div class="flex items-center justify-between font-caption text-caption pt-1">
<span class="text-outline">vs target benchmark</span>
<span class="font-label-sm text-label-sm text-tertiary font-medium">+$142.3k vs target</span>
</div>
</div>
<!-- Card 2: Active Users -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between space-y-3">
<div class="flex items-start justify-between">
<div class="space-y-1">
<span class="font-label-sm text-label-sm tracking-wider uppercase text-outline">Active Enterprise Users</span>
<div class="font-headline-md text-headline-md text-on-surface font-semibold font-label-md tracking-tight">
            48,291
          </div>
</div>
<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-surface-container-low text-tertiary font-label-sm text-label-sm font-medium">
<span class="material-symbols-outlined text-[14px]">arrow_upward</span>
          +8.2%
        </span>
</div>
<!-- Mini Sparkline SVG -->
<div class="h-8 w-full flex items-end">
<svg class="w-full h-8 overflow-visible" preserveaspectratio="none" viewbox="0 0 100 24">
<defs>
<lineargradient id="gradUsers" x1="0" x2="0" y1="0" y2="1">
<stop offset="0%" stop-color="#2563eb" stop-opacity="0.25"></stop>
<stop offset="100%" stop-color="#2563eb" stop-opacity="0.0"></stop>
</lineargradient>
</defs>
<path d="M0,18 Q16,14 30,16 T60,11 T80,7 T100,4 L100,24 L0,24 Z" fill="url(#gradUsers)"></path>
<path d="M0,18 Q16,14 30,16 T60,11 T80,7 T100,4" fill="none" stroke="#2563eb" stroke-linecap="round" stroke-width="1.75"></path>
</svg>
</div>
<div class="flex items-center justify-between font-caption text-caption pt-1">
<span class="text-outline">Real-time concurrency</span>
<span class="font-label-sm text-label-sm text-on-surface-variant font-medium">3,104 concurrent</span>
</div>
</div>
<!-- Card 3: Latency p99 -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between space-y-3">
<div class="flex items-start justify-between">
<div class="space-y-1">
<span class="font-label-sm text-label-sm tracking-wider uppercase text-outline">Average Latency (p99)</span>
<div class="font-headline-md text-headline-md text-on-surface font-semibold font-label-md tracking-tight">
            184<span class="font-body-sm text-body-sm text-outline ml-0.5">ms</span>
</div>
</div>
<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-surface-container-low text-tertiary font-label-sm text-label-sm font-medium">
<span class="material-symbols-outlined text-[14px]">arrow_downward</span>
          -14.6%
        </span>
</div>
<!-- Mini Sparkline SVG -->
<div class="h-8 w-full flex items-end">
<svg class="w-full h-8 overflow-visible" preserveaspectratio="none" viewbox="0 0 100 24">
<defs>
<lineargradient id="gradLat" x1="0" x2="0" y1="0" y2="1">
<stop offset="0%" stop-color="#006242" stop-opacity="0.25"></stop>
<stop offset="100%" stop-color="#006242" stop-opacity="0.0"></stop>
</lineargradient>
</defs>
<path d="M0,6 Q20,10 40,16 T70,12 T85,20 T100,19 L100,24 L0,24 Z" fill="url(#gradLat)"></path>
<path d="M0,6 Q20,10 40,16 T70,12 T85,20 T100,19" fill="none" stroke="#006242" stroke-linecap="round" stroke-width="1.75"></path>
</svg>
</div>
<div class="flex items-center justify-between font-caption text-caption pt-1">
<span class="text-outline">SLA standard limit</span>
<span class="font-label-sm text-label-sm text-on-surface-variant font-medium">Target: &lt;250ms</span>
</div>
</div>
<!-- Card 4: Error Rate -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between space-y-3">
<div class="flex items-start justify-between">
<div class="space-y-1">
<span class="font-label-sm text-label-sm tracking-wider uppercase text-outline">System Error Rate</span>
<div class="font-headline-md text-headline-md text-on-surface font-semibold font-label-md tracking-tight">
            0.042<span class="font-body-sm text-body-sm text-outline ml-0.5">%</span>
</div>
</div>
<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm font-medium">
<span class="material-symbols-outlined text-[14px]">priority_high</span>
          +0.01%
        </span>
</div>
<!-- Mini Sparkline SVG -->
<div class="h-8 w-full flex items-end">
<svg class="w-full h-8 overflow-visible" preserveaspectratio="none" viewbox="0 0 100 24">
<defs>
