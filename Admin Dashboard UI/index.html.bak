          "background": "#fbf8ff",
          "on-secondary": "#ffffff",
          "on-secondary-fixed-variant": "#474649",
          "surface-container-high": "#e8e7f1",
          "inverse-primary": "#b4c5ff",
          "on-primary-container": "#eeefff",
          "error-container": "#ffdad6"
        },
