          "gutter-desktop": "1.5rem",
          "margin-desktop": "2rem",
          "margin": "1rem"
        },
        "fontFamily": {
          "headline-sm": [
            "Inter"
          ],
          "body-lg": [
            "Inter"
          ],
          "label-sm": [
            "JetBrains Mono"
          ],
          "headline-md": [
            "Inter"
          ],
          "headline-lg": [
            "Inter"
          ],
          "body-sm": [
            "Inter"
          ],
          "body-md": [
            "Inter"
          ],
          "label-md": [
            "JetBrains Mono"
          ],
