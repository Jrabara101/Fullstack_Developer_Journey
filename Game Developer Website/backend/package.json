{
  "name": "gamedev-portfolio-backend",
  "version": "1.0.0",
  "description": "Fastify + SQLite/Prisma backend for Game Dev Portfolio, Mechanics Lab & Dev-Log Platform",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
