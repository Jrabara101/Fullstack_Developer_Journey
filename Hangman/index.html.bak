<!DOCTYPE html>

<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="web_standard" name="shell-type" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100..900&family=Plus+Jakarta+Sans:wght@100..900&display=swap"
        rel="stylesheet" />
    <style>
        @layer base {

            html,
            body {
                margin: 0;
                padding: 0;
            }

            body {
                overscroll-behavior: none;
            }

            main>:first-child {
                margin-top: 0 !important;
            }

            main>:last-child {
                margin-bottom: 0 !important;
            }
        }

        ::-webkit-scrollbar {
            display: none;
        }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script
        id="tailwind-config">tailwind.config = { darkMode: "class", theme: { extend: { colors: { "outline-variant": "#3c4a42", "surface-container-high": "#2e2925", "primary-fixed-dim": "#4edea3", "primary": "#4edea3", "surface-tint": "#4edea3", "secondary-fixed": "#ffdad7", "on-tertiary": "#472a00", "surface-bright": "#3e3834", "on-background": "#eae1da", "outline": "#86948a", "primary-fixed": "#6ffbbe", "error": "#ffb4ab", "on-surface-variant": "#bbcabf", "on-tertiary-fixed": "#2a1700", "primary-container": "#10b981", "inverse-primary": "#006c49", "background": "#17130f", "on-primary": "#003824", "on-secondary-container": "#ffaea8", "surface-container-low": "#1f1b17", "on-primary-container": "#00422b", "tertiary": "#ffb95f", "surface-container-lowest": "#110d0a", "surface": "#17130f", "on-primary-fixed-variant": "#005236", "on-secondary-fixed": "#410004", "surface-variant": "#393430", "secondary-container": "#a40217", "error-container": "#93000a", "inverse-on-surface": "#342f2b", "on-tertiary-container": "#523200", "on-error-container": "#ffdad6", "on-error": "#690005", "tertiary-fixed-dim": "#ffb95f", "secondary-fixed-dim": "#ffb3ad", "on-tertiary-fixed-variant": "#653e00", "on-secondary-fixed-variant": "#930013", "surface-container-highest": "#393430", "inverse-surface": "#eae1da", "tertiary-fixed": "#ffddb8", "on-primary-fixed": "#002113", "tertiary-container": "#e29100", "surface-dim": "#17130f", "on-surface": "#eae1da", "on-secondary": "#68000a", "secondary": "#ffb3ad", "surface-container": "#231f1b" }, borderRadius: { DEFAULT: "0.125rem", lg: "0.25rem", xl: "0.5rem", full: "0.75rem" }, spacing: { "space-xs": "0.25rem", "gutter-desktop": "1.5rem", "margin-tablet": "1.5rem", margin: "1rem", "space-md": "1rem", gutter: "1rem", "space-xl": "2.25rem", "space-sm": "0.5rem", "space-lg": "1.5rem", "margin-desktop": "2.5rem" }, fontFamily: { "headline-lg": ["Plus Jakarta Sans"], "headline-xl": ["Plus Jakarta Sans"], "headline-lg-mobile": ["Plus Jakarta Sans"], "body-lg": ["JetBrains Mono"], "label-md": ["JetBrains Mono"], "headline-xl-mobile": ["Plus Jakarta Sans"], "label-sm": ["JetBrains Mono"], "title-lg": ["Plus Jakarta Sans"], "body-md": ["JetBrains Mono"], "title-md": ["JetBrains Mono"], "headline-md": ["Plus Jakarta Sans"], "cipher-display": ["JetBrains Mono"], "cipher-display-mobile": ["JetBrains Mono"], keycap: ["JetBrains Mono"] }, fontSize: { "headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.01em", fontWeight: "700" }], "headline-xl": ["48px", { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "800" }], "headline-lg-mobile": ["24px", { lineHeight: "32px", letterSpacing: "0em", fontWeight: "700" }], "body-lg": ["15px", { lineHeight: "24px", letterSpacing: "0em", fontWeight: "400" }], "label-md": ["12px", { lineHeight: "16px", letterSpacing: "0.08em", fontWeight: "500" }], "headline-xl-mobile": ["32px", { lineHeight: "40px", letterSpacing: "-0.01em", fontWeight: "800" }], "label-sm": ["10px", { lineHeight: "14px", letterSpacing: "0.12em", fontWeight: "600" }], "title-lg": ["20px", { lineHeight: "28px", letterSpacing: "0.01em", fontWeight: "600" }], "body-md": ["13px", { lineHeight: "20px", letterSpacing: "0.01em", fontWeight: "400" }], "title-md": ["16px", { lineHeight: "24px", letterSpacing: "0.04em", fontWeight: "600" }], "headline-md": ["24px", { lineHeight: "32px", letterSpacing: "0em", fontWeight: "700" }], "cipher-display": ["36px", { lineHeight: "44px", letterSpacing: "0.15em", fontWeight: "700" }], "cipher-display-mobile": ["24px", { lineHeight: "32px", letterSpacing: "0.1em", fontWeight: "700" }], keycap: ["18px", { lineHeight: "22px", letterSpacing: "0.02em", fontWeight: "600" }] } } } }</script>
</head>

<body
    class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary selection:text-on-primary min-h-screen">
    <header
        class="fixed top-0 left-0 right-0 z-50 bg-surface-container-lowest/90 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.4)]">
        <div class="h-20 w-full px-space-md lg:px-gutter-desktop flex items-center justify-between gap-space-md">
            <div class="flex items-center gap-space-md min-w-fit"><img alt="The Cipher Gallows Brand Emblem"
                    class="h-8 w-auto object-contain"
                    src="https://lh3.googleusercontent.com/aida/AEtjO1Wux2NcMiniH44bxymNQ0le-bnY_YTfcWGfZGv0BuXOsTEYN3qyWbanH38lpoB0TIQVoQ6Qw7jX_Jc_SkYSB3y8azBUgFBAOLSXCvzsf_sMp4mmMUk_MSlrjwa5dGbwldZsAhk4mWahwoDzZqHhWHKn771FaMFIIMvFqqEfoxPfm28GL1B76vT-8HpokvJ6WI7gepkf6FGFiDzPeghIPDEPxS6sR9DiRrip2zYO4KRhlipXhok7KrqzAQzZ" />
                <div class="flex flex-col"><span
                        class="font-title-md text-title-md text-on-surface uppercase tracking-wider">THE CIPHER
                        GALLOWS</span><span class="font-label-sm text-label-sm text-primary uppercase">TAC-OP //
                        PROTOCOL v4.2</span></div>
            </div>
            <div class="hidden xl:flex items-center gap-space-md flex-1 justify-center">
                <div class="flex items-center gap-space-xs px-space-sm py-1 bg-surface-container-low rounded"><span
                        class="material-symbols-outlined text-[16px] text-tertiary">calendar_today</span><span
                        class="font-label-md text-label-md text-on-surface">OPERATION: OBSIDIAN // SEED #8942</span>
                </div>
                <div class="flex items-center gap-space-xs px-space-sm py-1 bg-surface-container-low rounded"><span
                        class="material-symbols-outlined text-[16px] text-tertiary">local_fire_department</span><span
                        class="font-label-md text-label-md text-tertiary">14 DAYS</span></div>
                <div class="flex items-center gap-space-sm px-space-sm py-1 bg-surface-container-low rounded"><span
                        class="font-label-sm text-label-sm text-on-surface-variant uppercase">STRIKES: 03 / 06</span>
                    <div class="flex items-center gap-1"><span
                            class="w-1.5 h-3 bg-secondary-container rounded-sm"></span><span
                            class="w-1.5 h-3 bg-secondary-container rounded-sm"></span><span
                            class="w-1.5 h-3 bg-secondary-container rounded-sm"></span><span
                            class="w-1.5 h-3 bg-surface-container-highest rounded-sm"></span><span
                            class="w-1.5 h-3 bg-surface-container-highest rounded-sm"></span><span
                            class="w-1.5 h-3 bg-surface-container-highest rounded-sm"></span></div>
                </div>
            </div>
            <nav class="hidden md:flex items-center gap-space-xs"
                data-active-classes="bg-surface-container-high text-primary"><a aria-current="page"
                    class="px-space-sm py-1 font-label-md transition-colors uppercase bg-surface-container-high text-primary"
                    data-path="tactical-decryption-deck" href="#">CONSOLE</a><a
                    class="px-space-sm py-1 font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors uppercase"
                    data-path="schematic-archive" href="#">ARCHIVE</a><a
                    class="px-space-sm py-1 font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors uppercase"
                    data-path="cadence-and-field-manual" href="#">MANUAL</a></nav>
            <div class="flex items-center gap-space-sm min-w-fit"><button
                    class="p-1.5 bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface rounded transition-colors flex items-center justify-center"
                    title="Tactical Audio Channel" type="button"><span
                        class="material-symbols-outlined text-[18px]">volume_up</span></button>
                <div class="hidden sm:flex items-center gap-1 px-space-sm py-1 bg-surface-container-low rounded"><span
                        class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span><span
                        class="font-label-sm text-label-sm text-on-surface-variant">HINT RADAR: READY</span></div>
                <button
                    class="p-1.5 bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface rounded transition-colors flex items-center justify-center"
                    title="Frequency Toggle" type="button"><span
                        class="material-symbols-outlined text-[18px]">tune</span></button>
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span
                        class="material-symbols-outlined text-on-primary text-[18px]">person</span></div>
            </div>
        </div>
    </header>
    <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]">
        <div
            class="flex flex-col w-full px-space-md lg:px-gutter-desktop py-space-md max-w-7xl mx-auto space-y-space-md select-none">
            <!-- TOP SYSTEM CALIBRATION BAR -->
            <div
                class="flex flex-wrap items-center justify-between gap-space-sm bg-surface-container-lowest p-space-sm rounded-lg shadow-xl">
                <div class="flex items-center gap-space-md">
                    <div class="flex items-center gap-space-xs">
                        <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
                        <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">TACTICAL
                            CONSOLE // ONLINE</span>
                    </div>
                    <span class="font-label-sm text-label-sm text-outline-variant">::</span>
                    <span class="font-label-sm text-label-sm text-on-surface-variant">TARGET DECK: <span
                            class="text-tertiary">#OP-9941_SIGMA</span></span>
                </div>
                <div class="flex items-center gap-space-md">
                    <div class="flex items-center gap-space-xs">
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">DECRYPTION
                            SUCCESS:</span>
                        <span class="font-label-md text-label-md text-primary font-bold" id="stat-ratio">50.0%</span>
                    </div>
                    <div class="flex items-center gap-1.5 bg-surface-container px-space-sm py-0.5 rounded">
                        <span
                            class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">PRESSURE:</span>
                        <div class="flex items-center gap-1" id="strike-meter">
                            <span
                                class="w-2 h-3.5 bg-secondary-container rounded-sm shadow-[0_0_6px_rgba(239,68,68,0.5)]"></span>
                            <span
                                class="w-2 h-3.5 bg-secondary-container rounded-sm shadow-[0_0_6px_rgba(239,68,68,0.5)]"></span>
                            <span
                                class="w-2 h-3.5 bg-secondary-container rounded-sm shadow-[0_0_6px_rgba(239,68,68,0.5)]"></span>
                            <span class="w-2 h-3.5 bg-surface-variant rounded-sm strike-pip"></span>
                            <span class="w-2 h-3.5 bg-surface-variant rounded-sm strike-pip"></span>
                            <span class="w-2 h-3.5 bg-surface-variant rounded-sm strike-pip"></span>
                        </div>
                    </div>
                </div>
            </div>
            <!-- MAIN OPERATIONAL STAGE: SPLIT COCKPIT -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-md items-start">
                <!-- LEFT DECK: BLUEPRINT VECTOR CHAMBER & TELEMETRY GAUGES (5 COLUMNS) -->
                <div class="lg:col-span-5 flex flex-col space-y-space-sm">
                    <div
                        class="relative bg-surface-container-low rounded-xl p-space-md shadow-2xl overflow-hidden flex flex-col items-center justify-between min-h-[460px]">
                        <!-- Drafting Coordinate Grid Overlay Background -->
                        <div
                            class="absolute inset-0 pointer-events-none opacity-20 bg-[radial-gradient(#86948a_1px,transparent_1px)] [background-size:16px_16px]">
                        </div>
                        <!-- Millimeter Crosshair Marks -->
                        <div class="absolute top-2 left-2 font-label-sm text-[9px] text-outline font-mono">00.00° /
                            LAT-N</div>
                        <div class="absolute top-2 right-2 font-label-sm text-[9px] text-outline font-mono">
                            GALLOWS_ASSEMBLY_MK_IV</div>
                        <div class="absolute bottom-2 left-2 font-label-sm text-[9px] text-outline font-mono">CALIPER
                            TOLERANCE: ±0.02mm</div>
                        <div class="absolute bottom-2 right-2 font-label-sm text-[9px] text-primary font-mono"
                            id="node-telemetry">NODE_ALPHA: CALIBRATED</div>
                        <!-- Metric Rulers Simulation Lines -->
                        <div class="absolute left-0 top-12 bottom-12 w-2 flex flex-col justify-between opacity-30">
                            <span class="w-full h-px bg-outline"></span><span class="w-1/2 h-px bg-outline"></span>
                            <span class="w-full h-px bg-outline"></span><span class="w-1/2 h-px bg-outline"></span>
                            <span class="w-full h-px bg-outline"></span><span class="w-1/2 h-px bg-outline"></span>
                            <span class="w-full h-px bg-outline"></span><span class="w-1/2 h-px bg-outline"></span>
                            <span class="w-full h-px bg-outline"></span>
                        </div>
                        <!-- HUD Header Over Vector -->
                        <div class="w-full flex items-center justify-between z-10">
                            <div
                                class="flex items-center gap-space-xs bg-surface-container-lowest/80 px-space-sm py-1 rounded backdrop-blur-md">
                                <span class="material-symbols-outlined text-primary text-[14px]">architecture</span>
                                <span class="font-label-sm text-label-sm text-on-surface uppercase">ISOMETRIC CADENCE
                                    STAGE</span>
                            </div>
                            <div class="font-label-sm text-label-sm bg-secondary-container/30 text-secondary px-2 py-0.5 rounded flex items-center gap-1 font-mono"
                                id="pressure-badge">
                                <span class="w-1.5 h-1.5 rounded-full bg-secondary animate-ping"></span>
                                STRIKE LOAD: 3/6
                            </div>
                        </div>
                        <!-- 400x400 Tactical SVG Gallows Canvas -->
                        <div
                            class="relative w-full max-w-[340px] aspect-square my-auto flex items-center justify-center">
                            <svg class="w-full h-full drop-shadow-[0_0_15px_rgba(0,0,0,0.8)]" fill="none"
                                id="gallows-blueprint" viewbox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <pattern height="20" id="grid-pattern" patternunits="userSpaceOnUse" width="20">
                                        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#2e2925" stroke-width="0.5">
                                        </path>
                                    </pattern>
                                </defs>
                                <rect fill="url(#grid-pattern)" height="400" width="400"></rect>
                                <!-- Permanent Structural Framework (Ghost Draft) -->
                                <!-- Base Line -->
                                <line stroke="#393430" stroke-linecap="round" stroke-width="3" x1="60" x2="340" y1="360"
                                    y2="360"></line>
                                <circle cx="200" cy="360" fill="#393430" r="4"></circle>
                                <circle cx="100" cy="360" fill="#393430" r="4"></circle>
                                <!-- Upright Strut Base Anchor -->
                                <path d="M80 360 L120 360 L100 320 Z" fill="#2e2925" stroke="#393430"
                                    stroke-width="1.5"></path>
                                <!-- STAGE 1: Main Upright Mast -->
                                <g class="transition-all duration-500" id="svg-part-1">
                                    <line stroke="#eae1da" stroke-dasharray="8 2" stroke-width="3.5" x1="100" x2="100"
                                        y1="360" y2="60"></line>
                                    <circle cx="100" cy="210" fill="#4edea3" r="3"></circle>
                                    <text fill="#86948a" font-family="JetBrains Mono" font-size="8" x="108"
                                        y="214">BEAM_VERT // 300mm</text>
                                </g>
                                <!-- STAGE 2: Transverse Crossbeam & Brass Tension Bracket -->
                                <g class="transition-all duration-500" id="svg-part-2">
                                    <line stroke="#eae1da" stroke-width="3.5" x1="98" x2="280" y1="60" y2="60"></line>
                                    <!-- Angular Strut Support -->
                                    <line stroke="#4edea3" stroke-width="2" x1="100" x2="160" y1="120" y2="60"></line>
                                    <circle cx="160" cy="60" fill="#4edea3" r="3"></circle>
                                    <circle cx="100" cy="120" fill="#4edea3" r="3"></circle>
                                    <text fill="#86948a" font-family="JetBrains Mono" font-size="8" x="140"
                                        y="52">BRACKET_AZIMUTH</text>
                                </g>
                                <!-- STAGE 3: Heavy Caliper Tackle & Braided Cord Drop -->
                                <g class="transition-all duration-500" id="svg-part-3">
                                    <rect fill="#2e2925" height="12" stroke="#eae1da" stroke-width="1.5" width="16"
                                        x="252" y="60"></rect>
                                    <line stroke="#ffb95f" stroke-dasharray="3 2" stroke-width="2" x1="260" x2="260"
                                        y1="72" y2="130"></line>
                                    <!-- Carabiner / Ring Node -->
                                    <circle cx="260" cy="136" r="6" stroke="#ffb95f" stroke-width="2"></circle>
                                    <circle cx="260" cy="136" fill="#ffb4ab" r="2"></circle>
                                    <text fill="#ffb95f" font-family="JetBrains Mono" font-size="8" x="272"
                                        y="110">SUSP_CORD // T-100</text>
                                </g>
                                <!-- STAGE 4: Mechanical Cranium & Optical Sensory Array -->
                                <g class="transition-all duration-500 opacity-20 stroke-dasharray-2" id="svg-part-4">
                                    <circle cx="260" cy="168" fill="#1f1b17" r="22" stroke="#eae1da" stroke-width="2">
                                    </circle>
                                    <!-- Reticle Sight in eye -->
                                    <circle cx="254" cy="164" fill="#ffb4ab" r="3"></circle>
                                    <circle cx="266" cy="164" fill="#ffb4ab" r="3"></circle>
                                    <line stroke="#eae1da" stroke-width="1.5" x1="245" x2="275" y1="178" y2="178">
                                    </line>
                                    <line stroke="#eae1da" stroke-width="1" x1="250" x2="250" y1="178" y2="184"></line>
                                    <line stroke="#eae1da" stroke-width="1" x1="260" x2="260" y1="178" y2="184"></line>
                                    <line stroke="#eae1da" stroke-width="1" x1="270" x2="270" y1="178" y2="184"></line>
                                    <text fill="#bbcabf" font-family="JetBrains Mono" font-size="7" x="290"
                                        y="165">CRANIUM_MK2</text>
                                </g>
                                <!-- STAGE 5: Articulated Thorax & Armatures -->
                                <g class="transition-all duration-500 opacity-20" id="svg-part-5">
                                    <line stroke="#eae1da" stroke-width="3" x1="260" x2="260" y1="190" y2="265"></line>
                                    <!-- Armature Left -->
                                    <polyline fill="none" points="260,205 225,235 215,260" stroke="#eae1da"
                                        stroke-width="2"></polyline>
                                    <circle cx="225" cy="235" fill="#4edea3" r="3"></circle>
                                    <!-- Armature Right -->
                                    <polyline fill="none" points="260,205 295,235 305,260" stroke="#eae1da"
                                        stroke-width="2"></polyline>
                                    <circle cx="295" cy="235" fill="#4edea3" r="3"></circle>
                                </g>
                                <!-- STAGE 6: Kinetic Pivot Legs & Ground Stanchions -->
                                <g class="transition-all duration-500 opacity-20" id="svg-part-6">
                                    <!-- Leg Left -->
                                    <polyline fill="none" points="260,265 240,310 235,348" stroke="#eae1da"
                                        stroke-width="2"></polyline>
                                    <circle cx="240" cy="310" fill="#ffb4ab" r="3"></circle>
                                    <!-- Leg Right -->
                                    <polyline fill="none" points="260,265 280,310 285,348" stroke="#eae1da"
                                        stroke-width="2"></polyline>
                                    <circle cx="280" cy="310" fill="#ffb4ab" r="3"></circle>
                                    <!-- Base Lock Pins -->
                                    <line stroke="#ffb4ab" stroke-width="2" x1="225" x2="245" y1="348" y2="348"></line>
                                    <line stroke="#ffb4ab" stroke-width="2" x1="275" x2="295" y1="348" y2="348"></line>
                                    <text fill="#ffb4ab" font-family="JetBrains Mono" font-size="7" x="210"
                                        y="325">CRITICAL_FAIL_LOCK</text>
                                </g>
                            </svg>
                        </div>
                        <!-- Canvas Diagnostic Lower HUD -->
                        <div
                            class="w-full grid grid-cols-3 gap-space-xs pt-space-xs mt-space-xs bg-surface-container-lowest/90 px-space-sm py-space-xs rounded">
                            <div class="flex flex-col">
                                <span class="font-label-sm text-[9px] text-on-surface-variant uppercase">CHAMBER
                                    PSI</span>
                                <span class="font-title-md text-title-md text-primary font-mono tracking-tight">101.4
                                    <span class="text-[10px] text-on-surface-variant">kPA</span></span>
                            </div>
                            <div class="flex flex-col">
                                <span
                                    class="font-label-sm text-[9px] text-on-surface-variant uppercase">DECRYPTION</span>
                                <span class="font-title-md text-title-md text-tertiary font-mono tracking-tight">05 /
                                    10</span>
                            </div>
                            <div class="flex flex-col">
                                <span class="font-label-sm text-[9px] text-on-surface-variant uppercase">ENTROPY</span>
                                <span class="font-title-md text-title-md text-primary font-mono tracking-tight">0.142
                                    <span class="text-[10px] text-primary">LOW</span></span>
                            </div>
                        </div>
                    </div>
                    <!-- Quick Reset & Calibration Override -->
                    <div class="flex items-center justify-between px-space-sm py-1 bg-surface-container-low rounded-lg">
                        <button
                            class="flex items-center gap-space-xs text-on-surface-variant hover:text-on-surface transition-colors py-1"
                            id="btn-recalibrate" type="button">
                            <span class="material-symbols-outlined text-[16px] text-primary">refresh</span>
                            <span class="font-label-sm text-label-sm uppercase">RE-CALIBRATE SEED</span>
                        </button>
                        <span class="font-label-sm text-[10px] text-outline-variant font-mono">LATENCY: 14ms //
                            SYNCED</span>
                    </div>
                </div>
                <!-- RIGHT DECK: CIPHER WORD REVEAL MATRIX & TACTICAL WORKBAY (7 COLUMNS) -->
                <div class="lg:col-span-7 flex flex-col space-y-space-md">
                    <!-- CIPHER WORD REVEAL RACK (10 TILES: 'CRYPTOGRAM') -->
                    <div
                        class="bg-surface-container-low p-space-lg rounded-xl shadow-xl flex flex-col space-y-space-md">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-space-xs">
