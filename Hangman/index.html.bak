                    class="hidden sm:flex items-center gap-space-xs font-mono font-bold text-secondary text-label-sm bg-secondary-container/40 px-3 py-1 rounded">
                    HALT PROTOCOL READY
                </div>
            </div>
        </div>
        <!-- INTERACTION & TACTICAL LOGIC SCRIPT -->
        <script>
                (function () {
                    // Current target state
                    var targetWord = "CRYPTOGRAM";
                    var strikes = 3;
                    var maxStrikes = 6;
                    var revealedChars = { "C": true, "P": true, "T": true, "O": true, "A": true };

                    // DOM references
                    var keyboard = document.getElementById("keyboard-deck");
                    var cipherRack = document.getElementById("cipher-word-rack");
                    var strikeMeter = document.getElementById("strike-meter");
                    var statRatio = document.getElementById("stat-ratio");
                    var pressureBadge = document.getElementById("pressure-badge");
                    var nodeTelemetry = document.getElementById("node-telemetry");
                    var btnRecalibrate = document.getElementById("btn-recalibrate");
                    var btnSpendHint = document.getElementById("btn-spend-hint");

                    // Svg gallows segments
                    var svgParts = [
                        document.getElementById("svg-part-1"),
                        document.getElementById("svg-part-2"),
                        document.getElementById("svg-part-3"),
                        document.getElementById("svg-part-4"),
                        document.getElementById("svg-part-5"),
                        document.getElementById("svg-part-6")
                    ];

                    function updateStats() {
                        // Calculate decrypted fraction
                        var matchedCount = 0;
                        for (var i = 0; i < targetWord.length; i++) {
                            if (revealedChars[targetWord[i]]) {
                                matchedCount++;
                            }
                        }
                        var ratio = ((matchedCount / targetWord.length) * 100).toFixed(1) + "%";
                        if (statRatio) statRatio.textContent = ratio;

                        // Update strike meter
                        if (strikeMeter) {
                            var pips = strikeMeter.children;
                            for (var p = 0; p < pips.length; p++) {
                                if (p < strikes) {
                                    pips[p].className = "w-2 h-3.5 bg-secondary-container rounded-sm shadow-[0_0_6px_rgba(239,68,68,0.5)]";
                                } else {
                                    pips[p].className = "w-2 h-3.5 bg-surface-variant rounded-sm strike-pip";
                                }
                            }
                        }

                        // Update pressure HUD badge
                        if (pressureBadge) {
                            pressureBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-secondary animate-ping"></span> STRIKE LOAD: ' + strikes + '/' + maxStrikes;
                        }

                        // Sync SVG Gallows Parts visibility
                        for (var s = 0; s < svgParts.length; s++) {
                            if (svgParts[s]) {
                                if (s < strikes) {
                                    svgParts[s].classList.remove("opacity-20");
                                    svgParts[s].classList.add("opacity-100");
                                } else {
                                    svgParts[s].classList.add("opacity-20");
                                    svgParts[s].classList.remove("opacity-100");
                                }
                            }
                        }

                        if (nodeTelemetry) {
                            if (strikes >= 5) {
                                nodeTelemetry.textContent = "CRITICAL_OVERLOAD: THRESHOLD";
                                nodeTelemetry.className = "absolute bottom-2 right-2 font-label-sm text-[9px] text-secondary font-mono animate-pulse";
                            } else if (strikes >= 3) {
                                nodeTelemetry.textContent = "NODE_GAMMA: TENSION PEAK";
                                nodeTelemetry.className = "absolute bottom-2 right-2 font-label-sm text-[9px] text-tertiary font-mono";
                            } else {
                                nodeTelemetry.textContent = "NODE_ALPHA: CALIBRATED";
                                nodeTelemetry.className = "absolute bottom-2 right-2 font-label-sm text-[9px] text-primary font-mono";
                            }
                        }
                    }

                    function handleKeyClick(key, buttonEl) {
                        if (!buttonEl || buttonEl.disabled) return;

                        var isMatch = targetWord.indexOf(key) !== -1;

                        if (isMatch) {
                            revealedChars[key] = true;
                            // Transform button to matched state
                            buttonEl.disabled = true;
                            buttonEl.className = "tactile-key w-8 sm:w-11 h-12 bg-primary-container/20 rounded-md flex flex-col items-center justify-center shadow-[0_0_8px_rgba(78,222,163,0.3)] text-primary font-keycap text-keycap cursor-default";

                            // Flip & reveal matching tiles on cipher rack
                            var cards = cipherRack.querySelectorAll('.cipher-card[data-char="' + key + '"]');
                            cards.forEach(function (card) {
                                card.classList.add("scale-105");
                                var val = card.querySelector(".char-val");
                                var tick = card.querySelector(".char-tick");
                                if (val) {
                                    val.classList.remove("opacity-0");
                                    val.classList.add("text-primary");
                                }
                                if (tick) {
                                    tick.className = "char-tick absolute bottom-1 w-6 h-0.5 bg-primary rounded-full shadow-[0_0_8px_#4edea3]";
                                }
                                setTimeout(function () {
                                    card.classList.remove("scale-105");
                                }, 300);
                            });

                        } else {
                            // Strike state
                            if (strikes < maxStrikes) {
                                strikes++;
                            }
                            buttonEl.disabled = true;
                            buttonEl.className = "tactile-key w-8 sm:w-11 h-12 bg-surface-container-lowest rounded-md flex flex-col items-center justify-center text-outline-variant font-keycap text-keycap line-through cursor-not-allowed";
                        }

                        updateStats();
                    }

                    if (keyboard) {
                        keyboard.addEventListener("click", function (e) {
                            var btn = e.target.closest("button[data-key]");
                            if (btn) {
                                var char = btn.getAttribute("data-key");
                                handleKeyClick(char, btn);
                            }
                        });
                    }

                    if (btnSpendHint) {
                        btnSpendHint.addEventListener("click", function () {
                            var unrevealed = [];
                            for (var i = 0; i < targetWord.length; i++) {
                                var ch = targetWord[i];
                                if (!revealedChars[ch] && unrevealed.indexOf(ch) === -1) {
                                    unrevealed.push(ch);
                                }
                            }
                            if (unrevealed.length > 0) {
                                var hintChar = unrevealed[0];
                                var keyBtn = document.querySelector('button[data-key="' + hintChar + '"]');
                                if (keyBtn) {
                                    handleKeyClick(hintChar, keyBtn);
                                }
                            }
                        });
                    }

                    if (btnRecalibrate) {
                        btnRecalibrate.addEventListener("click", function () {
                            strikes = 0;
                            revealedChars = { "C": true, "P": true, "T": true, "O": true, "A": true };

                            // Reset non-revealed cards
                            var cards = cipherRack.querySelectorAll('.cipher-card');
                            cards.forEach(function (card) {
                                var val = card.querySelector(".char-val");
                                var tick = card.querySelector(".char-tick");
                                if (val) {
                                    val.classList.add("opacity-0");
                                    val.classList.remove("text-primary");
                                }
                                if (tick) {
                                    tick.className = "char-tick absolute bottom-1 w-6 h-0.5 bg-surface-variant rounded-full";
                                }
                            });

                            // Reset keyboard buttons
                            var buttons = keyboard.querySelectorAll("button[data-key]");
                            buttons.forEach(function (b) {
                                var k = b.getAttribute("data-key");
                                if (revealedChars[k]) {
                                    b.disabled = true;
                                    b.className = "tactile-key w-8 sm:w-11 h-12 bg-primary-container/20 rounded-md flex flex-col items-center justify-center shadow-[0_0_8px_rgba(78,222,163,0.3)] text-primary font-keycap text-keycap cursor-default";
                                } else {
                                    b.disabled = false;
                                    b.className = "tactile-key w-8 sm:w-11 h-12 bg-surface-container-high rounded-md flex flex-col items-center justify-center shadow-md active:translate-y-0.5 transition-all text-on-surface font-keycap text-keycap";
                                }
                            });

                            updateStats();
                        });
                    }

                    // Initial render call
                    updateStats();
                })();
        </script>
    </main>
    <footer class="w-full bg-surface-container-lowest py-space-lg">
        <div
            class="w-full px-space-md lg:px-gutter-desktop flex flex-col md:flex-row items-center justify-between gap-space-md">
            <div class="flex items-center gap-space-md"><span
                    class="font-label-sm text-label-sm text-on-surface-variant uppercase">TERMINAL STATUS:
                    ONLINE</span><span class="font-label-sm text-label-sm text-outline-variant">|</span><span
                    class="font-label-sm text-label-sm text-on-surface-variant uppercase">CRYPTO ENGINE V4.2</span>
            </div>
            <div class="font-label-sm text-label-sm text-on-surface-variant text-center">© NEO-VICTORIAN CRYPTOGRAPHIC
                WORKSHOP // RESTRICTED CADENCE</div>
            <div class="flex items-center gap-space-md"><a
                    class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary uppercase transition-colors"
                    href="#">TELEMETRY</a><a
                    class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary uppercase transition-colors"
                    href="#">LEGAL_PROTOCOL</a></div>
        </div>
    </footer>
</body>

</html>