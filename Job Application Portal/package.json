{
  "name": "job-application-portal",
  "version": "1.0.0",
  "type": "module",
  "description": "High-Conversion Job Application Portal & Candidate Experience Engine",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
